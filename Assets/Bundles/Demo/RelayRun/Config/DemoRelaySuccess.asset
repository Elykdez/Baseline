  title: Relay restored
  titleKey: DemoRelay_SuccessTitle
  lines:
  - speaker: {fileID: 11400000, guid: 61809e1d8c5f41448858dc44d38f860e, type: 2}
    expression: default
    text: We have your signal, R-07. Six hundred metres, one determined little robot,
      and a connection restored.
    textKey: DemoRelay_SuccessOne
    illustration: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 61809e1d8c5f41448858dc44d38f860e, type: 2}
    expression: default
    text: Your delivery is recorded. You can run the route again, or head back to
      the station menu.
    textKey: DemoRelay_SuccessTwo
    illustration: {fileID: -945887239, guid: 9aeb3e8ff8367c34fb7082aaafef2b4d, type: 3}
