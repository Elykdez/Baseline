  title: Signal interrupted
  titleKey: DemoRelay_FailTitle
  lines:
  - speaker: {fileID: 11400000, guid: 61809e1d8c5f41448858dc44d38f860e, type: 2}
    expression: default
    text: That obstacle got us. Your chassis is safe, and the relay can wait for
      another attempt.
    textKey: DemoRelay_FailOne
    illustration: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 61809e1d8c5f41448858dc44d38f860e, type: 2}
    expression: default
    text: Try jumping a little before the obstacle reaches your feet. Take a breath,
      then run again.
    textKey: DemoRelay_FailTwo
    illustration: {fileID: -945887239, guid: 9aeb3e8ff8367c34fb7082aaafef2b4d, type: 3}
